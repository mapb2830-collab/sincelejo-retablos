# Copia este archivo como .env.local para desarrollo. Nunca subas .env.local a GitHub.
# Solo las variables con prefijo VITE_ llegan al navegador: NUNCA pongas aquí
# claves privadas, secretos de integridad ni secretos de webhooks.

# Número de WhatsApp de pedidos en formato internacional, sin "+" ni espacios.
VITE_WHATSAPP_NUMBER=573013804470

# URL pública del sitio (para metadatos y enlaces compartidos). Opcional.
VITE_SITE_URL=

# Fase 2 (pagos). Déjalo en false hasta que exista el backend de pedidos y pagos.
VITE_PAYMENTS_ENABLED=false
# URL del backend de pedidos/pagos (servidor propio, NO GitHub Pages).
VITE_ORDERS_API_URL=

# --- Variables SOLO DEL SERVIDOR (fase 2). No usan prefijo VITE_ y no van en este proyecto frontend. ---
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
